# Copy to .env (or .env.local) and edit. Every variable is optional.
#
# Both `npm run dev:server` / `npm start` and `docker compose` read this file.
# Real environment variables take precedence over it.
#
# These are read by the server only. Nothing here is sent to the browser, so
# API keys stay private (never prefix them with VITE_).

# ── Model servers ─────────────────────────────────────────────────────────────
# The defaults already match the usual setups, so leave these commented unless
# your model server lives somewhere else. (Do not uncomment a localhost URL when
# using docker compose: inside the container, localhost is the container itself.)
#
# llama.cpp's llama-server (OpenAI-compatible API).
#   npm run dev default:     http://localhost:8080
#   docker compose default:  http://host.docker.internal:8080 (llama-server on your machine)
# LLAMA_SERVER_URL=

# Ollama.
#   npm run dev default:     http://localhost:11434
#   docker compose default:  http://host.docker.internal:11434 (Ollama on your machine;
#   start it with OLLAMA_HOST=0.0.0.0 so the container can reach it)
# OLLAMA_URL=

# ── Cloud providers (leave empty to disable) ──────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Point at any OpenAI-compatible service (OpenRouter, Groq, LM Studio, vLLM...).
# Include the /v1 part. Default: https://api.openai.com/v1
# OPENAI_BASE_URL=

# Default: https://api.anthropic.com
# ANTHROPIC_BASE_URL=

# ── Access control ────────────────────────────────────────────────────────────
# Protects the whole app (UI, API and provider proxies) with HTTP Basic auth.
# Set this whenever the app is reachable by anyone other than you.
# AUTH_USER=admin
# AUTH_PASSWORD=

# ── Server ────────────────────────────────────────────────────────────────────
# Port the API/UI server listens on. Default: 3001 (the Docker image uses 3000).
# PORT=3001

# Interface to bind. Default: 127.0.0.1 (this machine only). Use 0.0.0.0 to expose it.
# HOST=127.0.0.1

# Where the SQLite database is stored. Default: ./data
# DATA_DIR=./data

# Browser origins allowed to call the API cross-origin, comma-separated.
# Not needed for the normal setup, where the UI and API share one origin.
# CORS_ORIGIN=

# ── docker compose only ───────────────────────────────────────────────────────
# Host port and interface to publish the app on. Default: 127.0.0.1:3000
# APP_PORT=3000
# BIND_ADDRESS=127.0.0.1

# GGUF file inside ./models for the optional `llama` profile.
# MODEL_FILE=model.gguf
